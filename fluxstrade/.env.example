# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=replace-with-a-long-random-secret
SESSION_FILE_DIR=./.flask_session
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Deriv OAuth2 + API
# Register an OAuth2 app in Deriv and use the exact redirect URI below.
DERIV_CLIENT_ID=app_your_deriv_oauth_client_id
DERIV_REDIRECT_URI=http://localhost:5000/api/callback

# Deriv REST APIs require Deriv-App-ID. Usually this is the same application ID.
DERIV_APP_ID=app_your_deriv_oauth_client_id
DERIV_AUTH_URL=https://auth.deriv.com/oauth2/auth
DERIV_TOKEN_URL=https://auth.deriv.com/oauth2/token
DERIV_API_BASE_URL=https://api.derivws.com
DERIV_OAUTH_SCOPE=trade account_manage
