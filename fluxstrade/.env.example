# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=replace-with-a-long-random-secret
SESSION_FILE_DIR=./.flask_session
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Deriv API
DERIV_APP_ID=your_deriv_app_id

# Optional OAuth2 fallback routes.
# DERIV_CLIENT_ID is an OAuth app/client ID, not a user's API token.
# Leave these blank unless you want to keep the redirect login fallback.
DERIV_CLIENT_ID=xydGWz1zo275QoQ
DERIV_REDIRECT_URI=http://localhost:5000/api/callback
DERIV_OAUTH_SCOPE=trade

# Optional legacy authorize app_id (numeric, from legacy-api.deriv.com)
ENABLE_DERIV_LEGACY_APP_ID=false
DERIV_LEGACY_APP_ID=

DERIV_AUTH_URL=https://auth.deriv.com/oauth2/auth
DERIV_TOKEN_URL=https://auth.deriv.com/oauth2/token
DERIV_API_BASE_URL=https://api.derivws.com
