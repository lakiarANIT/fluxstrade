{
  "name": "fluxstrade",
  "private": true,
  "version": "0.1.0",
  "description": "Deriv OAuth trading account dashboard monorepo",
  "scripts": {
    "dev": "docker compose up --build",
    "dev:backend": "cd backend && flask --app app run --debug --host 0.0.0.0 --port 5000",
    "dev:frontend": "cd frontend && npm run dev",
    "install:frontend": "cd frontend && npm install"
  },
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=20"
  }
}
